generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CUSTOMER
  BUSINESS_OWNER
}

enum QueueTokenStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  SKIPPED
}

enum RepairJobStatus {
  RECEIVED
  DIAGNOSING
  IN_REPAIR
  READY_FOR_PICKUP
  COLLECTED
  CANCELLED
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  phone         String
  password      String
  accountType   AccountType @default(CUSTOMER)
  emailVerified Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses  Business[]
  queueTokens QueueToken[]
  repairJobs  RepairJob[]
}

model Business {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String
  phone       String

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  locations BusinessLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  hours            BusinessHours[]
  queueSessions    QueueSession[]
  repairJobs       RepairJob[]
  repairJobCounter RepairJobCounter?

  @@index([ownerId])
  @@index([category])
}

model BusinessLocation {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchName  String?
  addressLine String
  area        String?
  city        String
  state       String
  postalCode  String
  country     String  @default("India")

  latitude  Float?
  longitude Float?

  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([city, postalCode])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int
  isActive    Boolean  @default(true)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  queueTokens QueueToken[]

  repairJobs RepairJob[]

  @@index([businessId])
}

model BusinessHours {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  openTime  String?
  closeTime String?
  isClosed  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

//For salon shops.
model QueueSession {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime @db.Date

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  tokens QueueToken[]

  lastTokenNumber Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, date])
  @@index([businessId, date])
}

model QueueToken {
  id          String           @id @default(cuid())
  tokenNumber Int
  status      QueueTokenStatus @default(WAITING)

  sessionId  String
  customerId String
  serviceId  String

  session  QueueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customer User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, tokenNumber])
  @@unique([sessionId, customerId])
  @@index([sessionId, status])
  @@index([customerId])
}

model RepairJob {
  id        String @id @default(cuid())
  jobNumber Int

  itemName String
  issue    String

  status RepairJobStatus @default(RECEIVED)

  estimatedCost Float?
  finalCost     Float?

  customerId String
  businessId String
  serviceId  String?

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, jobNumber])
  @@index([customerId])
  @@index([businessId, status])
}

model RepairJobCounter {
  id            String @id @default(cuid())
  businessId    String @unique
  lastJobNumber Int    @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
